---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
const artworks = (await getCollection('artworks')).sort((a, b) => a.data.order - b.data.order);
const email = 'studio@example.com';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <meta name="description" content="A curated collection of original artwork." />
  <title>Art Factory Lines</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
  <header class="site-header">
    <a class="wordmark" href="/">Art Factory Lines</a>
    <nav aria-label="Main navigation"><a href="#artworks">Artworks</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav>
  </header>
  <main>
    <div class="breadcrumb"><span>Artworks</span><i>/</i><strong data-current-id>{artworks[0].data.artworkId}</strong></div>
    <section class="artwork-view" id="artworks" aria-live="polite">
      <div class="hero-image" data-hero role="button" tabindex="0" aria-label={`View ${artworks[0].data.title} full screen`}>
        <Image data-hero-image src={artworks[0].data.image} alt={artworks[0].data.alt} widths={[600, 900, 1200]} sizes="(min-width: 800px) 57vw, 100vw" />
      </div>
      <article class="artwork-info">
        <header><h1 data-title>{artworks[0].data.title}</h1><p data-year>{artworks[0].data.year}</p></header>
        <span class:list={["status", { sold: artworks[0].data.sold }]} data-status>{artworks[0].data.sold ? 'Sold' : 'Available'}</span>
        <dl>
          <div><dt>Artwork ID</dt><dd data-id>{artworks[0].data.artworkId}</dd></div>
          <div><dt>Year</dt><dd data-detail="year">{artworks[0].data.year}</dd></div>
          <div><dt>Size</dt><dd data-detail="dimensions">{artworks[0].data.dimensions}</dd></div>
          <div><dt>Technique</dt><dd data-detail="medium">{artworks[0].data.medium}</dd></div>
          <div><dt>Edition type</dt><dd data-detail="edition">{artworks[0].data.edition}</dd></div>
          <div><dt>Price</dt><dd data-detail="price">{artworks[0].data.sold ? 'Sold' : artworks[0].data.price}</dd></div>
          <div><dt>Certificate</dt><dd data-detail="certificate">{artworks[0].data.certificate}</dd></div>
        </dl>
        <p class="description" data-description>{artworks[0].data.description}</p>
        <a class="enquire" data-enquire href={`mailto:${email}?subject=Enquiry about ${artworks[0].data.title}`}>Inquire / buy artwork</a>
      </article>
    </section>
    <nav class="pager" aria-label="Browse artworks">
      <button type="button" data-previous>← <span>Previous artwork</span></button><span><b data-position>1</b> / {artworks.length}</span><button type="button" data-next><span>Next artwork</span> →</button>
    </nav>
    <section class="gallery-section" aria-label="Artwork gallery">
      <p class="section-label">Gallery</p>
      <div class="gallery-frame">
        <button class="gallery-arrow gallery-arrow--previous" type="button" data-gallery-previous aria-label="Previous gallery artworks" hidden={artworks.length <= 4}>←</button>
        <div class="gallery" data-gallery>{artworks.map((artwork, index) => (
          <button class:list={["thumb", { active: index === 0 }]} type="button" data-index={index} aria-label={`View ${artwork.data.title}`}>
            <Image src={artwork.data.image} alt="" widths={[360, 600]} sizes="(min-width: 800px) 22vw, 70vw" />
          </button>
        ))}</div>
        <button class="gallery-arrow gallery-arrow--next" type="button" data-gallery-next aria-label="Next gallery artworks" hidden={artworks.length <= 4}>→</button>
      </div>
    </section>
  </main>
  <dialog class="lightbox" data-lightbox aria-label="Full-screen artwork">
    <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close full-screen image">Close</button>
    <div class="lightbox-image" data-lightbox-image></div>
    <p data-lightbox-caption></p>
  </dialog>
  <footer><a class="wordmark" href="/">Art Factory Lines</a><p>All rights reserved</p></footer>
  <script is:inline define:vars={{ artworks: artworks.map(({ data }) => ({ ...data, image: data.image.src })), email }}>
    // @ts-nocheck
    let current = 0;
    const $ = (selector) => document.querySelector(selector);
    function showArtwork(index) {
      current = (index + artworks.length) % artworks.length;
      const artwork = artworks[current];
      const heroImage = $('[data-hero-image]');
      heroImage.removeAttribute('srcset');
      heroImage.removeAttribute('sizes');
      heroImage.src = artwork.image;
      heroImage.alt = artwork.alt;
      $('[data-hero]').setAttribute('aria-label', `View ${artwork.title} full screen`);
      $('[data-title]').textContent = artwork.title; $('[data-year]').textContent = artwork.year || '';
      $('[data-current-id]').textContent = artwork.artworkId; $('[data-id]').textContent = artwork.artworkId;
      $('[data-description]').textContent = artwork.description;
      $('[data-status]').textContent = artwork.sold ? 'Sold' : 'Available'; $('[data-status]').classList.toggle('sold', artwork.sold);
      ['year','dimensions','medium','edition','certificate'].forEach((key) => $(`[data-detail="${key}"]`).textContent = artwork[key] || '—');
      $('[data-detail="price"]').textContent = artwork.sold ? 'Sold' : (artwork.price || 'Price on request');
      const enquire = $('[data-enquire]'); enquire.textContent = artwork.sold ? 'Enquire about similar work' : 'Inquire / buy artwork';
      enquire.href = `mailto:${email}?subject=${encodeURIComponent(`Enquiry about ${artwork.title}`)}`;
      $('[data-position]').textContent = current + 1;
      document.querySelectorAll('.thumb').forEach((thumb, i) => { thumb.classList.toggle('active', i === current); thumb.setAttribute('aria-current', i === current ? 'true' : 'false'); });
    }
    document.querySelectorAll('.thumb').forEach((thumb) => thumb.addEventListener('click', () => { showArtwork(Number(thumb.dataset.index)); document.querySelector('.artwork-view').scrollIntoView({behavior:'smooth'}); }));
    $('[data-previous]').addEventListener('click', () => showArtwork(current - 1)); $('[data-next]').addEventListener('click', () => showArtwork(current + 1));
    const gallery = $('[data-gallery]');
    const galleryPrevious = $('[data-gallery-previous]');
    const galleryNext = $('[data-gallery-next]');
    function galleryStep() {
      const thumbnail = gallery.querySelector('.thumb');
      return thumbnail ? thumbnail.getBoundingClientRect().width + 16 : 0;
    }
    if (galleryPrevious && galleryNext) {
      galleryPrevious.addEventListener('click', () => gallery.scrollBy({ left: -galleryStep(), behavior: 'smooth' }));
      galleryNext.addEventListener('click', () => gallery.scrollBy({ left: galleryStep(), behavior: 'smooth' }));
    }
    let dragStartX = 0;
    let dragStartScroll = 0;
    let galleryDragged = false;
    gallery.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') return;
      dragStartX = event.clientX;
      dragStartScroll = gallery.scrollLeft;
      galleryDragged = false;
      gallery.classList.add('dragging');
      gallery.setPointerCapture(event.pointerId);
    });
    gallery.addEventListener('pointermove', (event) => {
      if (!gallery.hasPointerCapture(event.pointerId)) return;
      const distance = event.clientX - dragStartX;
      if (Math.abs(distance) > 5) galleryDragged = true;
      gallery.scrollLeft = dragStartScroll - distance;
    });
    function finishGalleryDrag(event) {
      if (gallery.hasPointerCapture(event.pointerId)) gallery.releasePointerCapture(event.pointerId);
      gallery.classList.remove('dragging');
    }
    gallery.addEventListener('pointerup', finishGalleryDrag);
    gallery.addEventListener('pointercancel', finishGalleryDrag);
    gallery.addEventListener('click', (event) => {
      if (galleryDragged) { event.preventDefault(); event.stopPropagation(); galleryDragged = false; }
    }, true);
    const lightbox = $('[data-lightbox]');
    function openLightbox() {
      // @ts-ignore `artworks` is injected by Astro's define:vars directive.
      const artwork = artworks[current];
      $('[data-lightbox-image]').innerHTML = `<img src="${artwork.image}" alt="${artwork.alt}">`;
      $('[data-lightbox-caption]').textContent = artwork.title;
      lightbox.showModal();
    }
    $('[data-hero]').addEventListener('click', openLightbox);
    $('[data-hero]').addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openLightbox(); }
    });
    $('[data-lightbox-close]').addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
  </script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', (user) => {
        if (!user) window.netlifyIdentity.on('login', () => { window.location.href = '/admin/'; });
      });
    }
  </script>
</body>
</html>
