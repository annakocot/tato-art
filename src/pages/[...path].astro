---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { labels, url, artworkPath, type Locale } from '../lib/site';
export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  const ids = artworks.map(a => artworkPath(a.data.artworkId));
  if (new Set(ids).size !== ids.length) throw new Error('Artwork IDs must be unique, including letter case.');
  return (['pl', 'en'] as const).flatMap(locale => ['', 'artworks', 'about', 'contact', 'buy', ...ids].map(path => ({ params: { path: [locale === 'en' ? 'en' : '', path].filter(Boolean).join('/') || undefined }, props: { locale, path } })));
}
const { locale, path } = Astro.props as { locale: Locale; path: string };
const t = labels[locale];
const artworks = (await getCollection('artworks')).sort((a,b) => a.data.order - b.data.order || a.data.artworkId.localeCompare(b.data.artworkId));
const home = (await getEntry('home', locale))!.data;
const buy = (await getEntry('buy', locale))!.data;
const profile = (await getEntry('about', locale === 'pl' ? 'profile' : 'en'))!;
const contact = (await getEntry('contact', locale === 'pl' ? 'details' : 'en'))!.data;
const { Content } = await render(profile);
const artwork = artworks.find(a => artworkPath(a.data.artworkId) === path);
const a = artwork?.data;
const text = a && (locale === 'en' ? a.en : a);
const selected = artworks.filter(a => a.data.selected).slice(0,4);
const index = artworks.findIndex(item => item.id === artwork?.id);
const title = text?.title || ({ '': t.home, artworks: t.artworks, about: t.about, contact: t.contact, buy: t.buy }[path] ?? t.home);
const description = text?.description || (path === 'buy' ? buy.introduction : path === 'about' ? profile.data.introduction : path === 'contact' ? contact.introduction : home.aboutDescription);
---
<Layout locale={locale} path={path} title={title} description={description}>
  {path === '' && <>
    <section class="home-hero">
      <div class="hero-copy"><h1>{home.title}</h1><p class="hero-subtitle">{home.subtitle}</p><p class="hero-description">{home.description}</p><a class="text-link" href={url(locale, 'artworks')}>{home.button}</a></div>
      <div class="hero-art"><Image src={home.heroImage} alt={home.heroAlt} widths={[640,960,1400]} sizes="(max-width: 760px) 90vw, 48vw" loading="eager" fetchpriority="high" /></div>
      <div class="hero-aside"><p class="motto">{home.motto}</p><div><p>{home.heroTitle}</p><p class="muted">{home.heroSeries}</p><span class="small-rule" aria-hidden="true"></span></div></div>
    </section>
    <section class="selected-section container"><div class="section-heading"><h2>{home.selectedTitle}</h2><a class="text-link" href={url(locale,'artworks')}>{home.allButton} <span aria-hidden="true">⟶</span></a></div><div class="art-grid">{selected.map(artwork => <ArtworkCard artwork={artwork} locale={locale} />)}</div>{selected.length === 0 && <p>{t.empty}</p>}</section>
    <section class="artist-intro container"><div><h2>{home.aboutHeadline}</h2><span class="small-rule" aria-hidden="true"></span><p class="intro-copy">{home.aboutDescription}</p><a class="text-link" href={url(locale,'about')}>{home.aboutButton}</a></div><Image src={home.aboutImage} alt={home.aboutAlt} widths={[480,800,1200]} sizes="(max-width: 760px) 90vw, 46vw" /><p class="image-caption">{home.aboutCaption}</p></section>
  </>}
  {path === 'artworks' && <section class="container page-section"><div class="page-heading"><p class="eyebrow">Art Factory Lines</p><h1>{t.artworks}</h1></div><div class="art-grid">{artworks.map(artwork => <ArtworkCard artwork={artwork} locale={locale} />)}</div>{!artworks.length && <p>{t.empty}</p>}</section>}
  {a && text && <div class="container page-section">
    <div class="breadcrumb"><a href={url(locale,'artworks')}>{t.artworks}</a><span>/</span><span>{a.artworkId}</span></div>
    <section class="artwork-detail"><button class="artwork-image" type="button" data-open-image aria-label={t.zoom}><Image src={a.image} alt={text.alt} widths={[640,960,1400]} sizes="(max-width: 760px) 90vw, 52vw" loading="eager" /><span class="zoom-label">{t.zoom} +</span></button><article><p class="eyebrow">{text.series || a.artworkId}</p><h1>{text.title}</h1><p class:list={['status',{sold:a.sold}]}>{a.sold ? t.sold : t.available}</p><dl>
      {[[t.id,a.artworkId],[t.series,text.series],[t.year,a.year],[t.dimensions,a.dimensions],[t.medium,text.medium],[t.edition,text.edition],[t.price,a.sold ? t.sold : a.price || t.request],[t.certificate,text.certificate]].filter(([,value]) => value !== undefined && value !== '').map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl><p class="detail-description">{text.description}</p><a class="solid-link" href={`mailto:${contact.email}?subject=${encodeURIComponent(`${a.sold ? t.similar : t.enquire}: ${text.title} (${a.artworkId})`)}`}>{a.sold ? t.similar : t.enquire}</a><a class="text-link buy-link" href={url(locale,'buy')}>{t.buy} ⟶</a></article></section>
    {artworks.length > 1 && <nav class="artwork-pager" aria-label={t.artworks}><a href={url(locale,artworkPath(artworks[(index-1+artworks.length)%artworks.length].data.artworkId))}>← {t.previous}</a><span>{index+1} / {artworks.length}</span><a href={url(locale,artworkPath(artworks[(index+1)%artworks.length].data.artworkId))}>{t.next} →</a></nav>}
    <dialog class="lightbox" aria-label={text.title}><button type="button" data-close-image>{t.close} ×</button><Image src={a.image} alt={text.alt} widths={[960,1600,2200]} sizes="90vw" /></dialog>
  </div>}
  {path === 'about' && <section class="container page-section about-layout"><Image src={profile.data.photo} alt={profile.data.photoAlt} widths={[480,800,1200]} sizes="(max-width: 760px) 90vw, 45vw" /><article><p class="eyebrow">{t.about}</p><h1>{profile.data.name}</h1><p class="lead">{profile.data.introduction}</p><div class="story"><Content /></div><a class="text-link" href={url(locale,'contact')}>{t.contact} ⟶</a></article></section>}
  {path === 'contact' && <section class="container page-section contact-layout"><div><p class="eyebrow">{t.contact}</p><h1>{contact.heading}</h1></div><div><p class="lead">{contact.introduction}</p><dl><div><dt>{t.phone}</dt><dd><a href={`tel:${contact.phone.replace(/[^+\d]/g,'')}`}>{contact.phone}</a></dd></div><div><dt>{t.email}</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>{[['Instagram',contact.instagram],['Facebook',contact.facebook]].map(([name,href]) => <div><dt>{name}</dt><dd><a href={href} target="_blank" rel="noreferrer">{t.profile} ↗</a></dd></div>)}</dl><a class="text-link buy-link" href={url(locale,'buy')}>{t.buy} ⟶</a></div></section>}
  {path === 'buy' && <section class="container page-section buying-page"><div class="page-heading"><p class="eyebrow">Art Factory Lines</p><h1>{buy.title}</h1><p class="lead">{buy.introduction}</p></div><ol class="buying-steps">{buy.steps.map((step,i) => <li><span class="step-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><div><h2>{step.title}</h2><p>{step.description}</p>{i===0 && <a class="text-link" href={url(locale,'artworks')}>{t.artworks} ⟶</a>}</div></li>)}</ol><div class="buying-contact"><p class="lead">{buy.closing}</p><a class="solid-link" href={url(locale,'contact')}>{buy.button}</a></div></section>}
</Layout>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  document.querySelector('[data-open-image]')?.addEventListener('click', () => { dialog?.showModal(); document.body.style.overflow = 'hidden'; });
  document.querySelector('[data-close-image]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => { document.body.style.overflow = ''; });
</script>
